// Pro Scalper Approximation — INDICATOR conversion of the v3.7 strategy.
//
// This is a 1:1 logic port of "Pro Scalper Approximation (v3.7 — Kalman
// SuperTrend + ADX Volatility Waves)" from a strategy() into an indicator().
// All entry/exit *timing* logic is preserved; the strategy-engine order calls
// (strategy.entry / strategy.exit / strategy.close) are replaced with a manual
// virtual-position state machine so the same stop/target/breakeven/zone/time
// exits still drive the on-chart levels, markers, and alerts.
//
// ─── ON "LAGGING ONE CANDLE" / MAKING IT LEADING ────────────────────────────
// The original is NON-REPAINTING: a SuperTrend flip is only true once the bar
// CLOSES, which is the inherent "1 candle late" behavior. You can't be both
// early AND guaranteed-correct (that needs future data). This indicator exposes
// three honest levers via "Signal Timing":
//   1. Confirmed (default)  — flip registered only at bar close. No repaint,
//                             but ~1 bar late. Same as the original strategy.
//   2. Real-time (leading)  — flip registered intrabar on the developing candle
//                             so the arrow appears immediately. LEADS by up to
//                             one bar but CAN REPAINT (appear then disappear
//                             before the bar closes). Use for discretionary
//                             heads-up, not for backtest-accurate signals.
//   3. Early-warning arrows — an ANTICIPATORY, non-repainting pre-signal that
//                             fires when price comes within warnAtrMult × ATR of
//                             the band it would need to cross to flip. This
//                             genuinely leads the confirmed flip without peeking
//                             at future bars. Shown as hollow diamonds.
// You can also reduce raw lag by lowering smoothing (Kalman R, ATR Period) at
// the cost of more noise/false flips — see the Core group tooltips.
//
// Everything else (Kalman filter, hand-built SuperTrend, ADX Volatility Wave
// zones, TP markers, compression, dashboard) is unchanged from the strategy.

//@version=6
indicator("Pro Scalper Approximation (v3.7 Indicator — Kalman SuperTrend + ADX Volatility Waves)",
     shorttitle="ProScalp~v3.7 [Ind]", overlay=true, max_labels_count=500)

// ───────────────────────────── Inputs ─────────────────────────────

grpTiming = "Signal Timing (lag vs. lead)"
signalMode = input.string("Confirmed (no repaint)", "Flag timing",
     options=["Confirmed (no repaint)", "Real-time (leading, may repaint)"], group=grpTiming,
     tooltip="Confirmed = flip locks in only at bar close (non-repainting, ~1 bar late, matches the original strategy). Real-time = flip is registered on the developing candle so the flag appears immediately (leads by up to one bar) but CAN REPAINT before the bar closes.")
showEarlyWarn = input.bool(true, "Show anticipatory early-warning diamonds", group=grpTiming,
     tooltip="Non-repainting pre-signal: fires when price comes within 'warnAtrMult × ATR' of the band it must cross to flip — a genuine lead on the confirmed flag without using future data.")
warnAtrMult = input.float(0.5, "Early-warning proximity (× ATR)", step=0.1, group=grpTiming,
     tooltip="Smaller = warns later but with fewer false alarms. Larger = warns earlier but more often. Distance from current close to the opposite SuperTrend band, measured in ATRs.")

grpCore = "Kalman-Filtered SuperTrend Core"
useKalman = input.bool(true, "Use Kalman-filtered price as SuperTrend basis", group=grpCore,
     tooltip="On = smooths price through a Kalman filter before computing the trend bands. Off = bands centered on hl2 (A/B comparison). Note: less smoothing = less lag but noisier flips.")
kfQ = input.float(0.01, "Kalman Process Noise (Q)", step=0.001, group=grpCore,
     tooltip="Higher = trusts new price more, tracks faster (less lag) but noisier.")
kfR = input.float(0.2, "Kalman Measurement Noise (R)", step=0.01, group=grpCore,
     tooltip="Higher = smooths harder (more lag). LOWER this to reduce the one-candle lag at the cost of more false flips. What matters is the Q/R ratio.")
stFactor = input.float(2.0, "Factor (band multiplier)", step=0.1, group=grpCore,
     tooltip="Best-fit value from a grid search against 37 real RTH Pro Scalper flags (33/37 = 89.2% match).")
stAtrPeriod = input.int(7, "ATR Period", group=grpCore,
     tooltip="Best-fit value. LOWER this to make bands react faster (less lag), at the cost of more whipsaw.")

grpSess = "Session Filter"
useSession   = input.bool(true, "Restrict signals to regular trading hours", group=grpSess)
sessionInput = input.session("0930-1600", "Session (exchange time)", group=grpSess)

grpZone = "ADX Volatility Wave Zones (exit reference)"
waveEquilLen = input.int(50, "Equilibrium (VWMA) Length", group=grpZone)
bbLen = input.int(20, "Bollinger Band Length (base volatility)", group=grpZone)
bbMult = input.float(1.5, "Bollinger Band StdDev multiplier", step=0.1, group=grpZone)
adxLen = input.int(14, "ADX Length", group=grpZone)
diLen = input.int(14, "DI Length", group=grpZone)
adxGain = input.float(0.8, "ADX amplitude gain (ADX Influence)", step=0.1, group=grpZone)
waveSmoothLen = input.int(10, "Structural smoothing length", group=grpZone)
baseOffsetMult = input.float(1.0, "Base offset beyond equilibrium (x smoothed width)", step=0.1, group=grpZone)
expansionMult = input.float(1.0, "Wave expansion (x smoothed width)", step=0.1, group=grpZone)
cooldownBars = input.int(5, "Neutral stabilization bars (cooldown)", group=grpZone)
compressionLookback = input.int(50, "Compression lookback (bars)", group=grpZone)
compressionPct = input.float(0.3, "Compression threshold (fraction of N-bar width range)", step=0.05, group=grpZone)
useZoneExit = input.bool(true, "Flag exit when price touches the opposite wave's outer edge", group=grpZone)
showZoneBands = input.bool(true, "Show wave gradient bands on chart", group=grpZone)
showCompression = input.bool(true, "Show compression background highlight", group=grpZone)
showTpMarkers = input.bool(true, "Show TP exhaustion markers", group=grpZone)

grpExit = "Virtual Exit Levels (for markers & alerts)"
stopAtrMult = input.float(1.5, "Initial Stop = N x ATR (fixed at entry)", step=0.1, group=grpExit)
targetAtrMult = input.float(2.0, "Profit Target = N x ATR (fixed at entry)", step=0.1, group=grpExit)
useBreakeven = input.bool(true, "Move stop to breakeven once favorable move hits N x ATR", group=grpExit)
breakevenAtrMult = input.float(1.0, "Breakeven trigger = N x ATR", step=0.1, group=grpExit)
useTimeStop = input.bool(true, "Time stop: exit if neither target nor stop hit in N bars", group=grpExit)
maxBarsInTrade = input.int(12, "Max bars in trade", group=grpExit)

grpDisp = "Display"
showRefLines = input.bool(true, "Show SuperTrend band as reference line", group=grpDisp)
showDashboard = input.bool(true, "Show status table", group=grpDisp)
showTradeLevels = input.bool(true, "Show entry/stop/target lines for open virtual trade", group=grpDisp)

isRealtime = signalMode == "Real-time (leading, may repaint)"

// ───────────────────────────── Kalman filter ─────────────────────────────

var float kfEstimate = na
var float kfError = 1.0

if na(kfEstimate)
    kfEstimate := close
kfErrorPred = kfError + kfQ
kalmanGain = kfErrorPred / (kfErrorPred + kfR)
kfEstimate := kfEstimate + kalmanGain * (close - kfEstimate)
kfError := (1 - kalmanGain) * kfErrorPred

// ───────────────────────────── Custom SuperTrend (Kalman-basis) ─────────────────────────────

atrVal = ta.atr(stAtrPeriod)
basisSrc = useKalman ? kfEstimate : hl2
upBasic = basisSrc - stFactor * atrVal
dnBasic = basisSrc + stFactor * atrVal

var float upBand = na
var float dnBand = na
var int trendState = 1

upBand := na(upBand[1]) ? upBasic : (close[1] > upBand[1] ? math.max(upBasic, upBand[1]) : upBasic)
dnBand := na(dnBand[1]) ? dnBasic : (close[1] < dnBand[1] ? math.min(dnBasic, dnBand[1]) : dnBasic)
trendState := na(trendState[1]) ? 1 :
     (trendState[1] == -1 and close > dnBand[1] ? 1 :
      trendState[1] == 1  and close < upBand[1] ? -1 :
      trendState[1])

isUptrend = trendState == 1
stLine = isUptrend ? upBand : dnBand

flippedLong  = trendState == 1  and trendState[1] == -1
flippedShort = trendState == -1 and trendState[1] == 1

inSession = not useSession or not na(time(timeframe.period, sessionInput))

// Timing gate: Confirmed = only fire on a closed bar (non-repainting, ~1 bar
// late). Real-time = fire intrabar on the developing candle (leads, may repaint).
timingOk = isRealtime or barstate.isconfirmed

longSignal  = flippedLong  and inSession and timingOk
shortSignal = flippedShort and inSession and timingOk

// Anticipatory early-warning (leads the confirmed flip, no future data):
// warn when price is within warnAtrMult × ATR of the band it must cross to flip.
warnFlipShort = isUptrend  and inSession and (close - upBand) <= warnAtrMult * atrVal and (close - upBand) > 0
warnFlipLong  = not isUptrend and inSession and (dnBand - close) <= warnAtrMult * atrVal and (dnBand - close) > 0
// Only show the first bar of a fresh warning to avoid clutter.
earlyWarnLong  = showEarlyWarn and warnFlipLong  and not warnFlipLong[1]
earlyWarnShort = showEarlyWarn and warnFlipShort and not warnFlipShort[1]

// ───────────────────────────── ADX Volatility Wave zones ─────────────────────────────

waveEquilibrium = ta.vwma(close, waveEquilLen)
bbStdev = ta.stdev(close, bbLen) * bbMult
[diPlus, diMinus, adxVal] = ta.dmi(diLen, adxLen)

adxNorm  = adxVal / 100
rawWidth = bbStdev * (1 + adxGain * adxNorm)
waveWidth = ta.rma(rawWidth, waveSmoothLen)

upperInner = waveEquilibrium + baseOffsetMult * waveWidth
upperOuter = waveEquilibrium + (baseOffsetMult + expansionMult) * waveWidth
lowerInner = waveEquilibrium - baseOffsetMult * waveWidth
lowerOuter = waveEquilibrium - (baseOffsetMult + expansionMult) * waveWidth

isOverbought = close >= upperOuter
isOversold   = close <= lowerOuter

upperL1 = upperInner
upperL2 = waveEquilibrium + (baseOffsetMult + expansionMult * 0.25) * waveWidth
upperL3 = waveEquilibrium + (baseOffsetMult + expansionMult * 0.50) * waveWidth
upperL4 = waveEquilibrium + (baseOffsetMult + expansionMult * 0.75) * waveWidth
upperL5 = upperOuter

lowerL1 = lowerInner
lowerL2 = waveEquilibrium - (baseOffsetMult + expansionMult * 0.25) * waveWidth
lowerL3 = waveEquilibrium - (baseOffsetMult + expansionMult * 0.50) * waveWidth
lowerL4 = waveEquilibrium - (baseOffsetMult + expansionMult * 0.75) * waveWidth
lowerL5 = lowerOuter

var bool longWaveActive  = false
var bool shortWaveActive = false
var int  neutralBars      = 0

inNeutral    = close < upperInner and close > lowerInner
newLongWave  = isOverbought and not longWaveActive
newShortWave = isOversold   and not shortWaveActive

if newLongWave
    longWaveActive := true
if newShortWave
    shortWaveActive := true

neutralBars := inNeutral ? neutralBars + 1 : 0
if neutralBars >= cooldownBars
    longWaveActive := false
    shortWaveActive := false

widthLowest  = ta.lowest(waveWidth, compressionLookback)
widthHighest = ta.highest(waveWidth, compressionLookback)
widthRange   = widthHighest - widthLowest
isCompressed = widthRange > 0 and (waveWidth - widthLowest) <= widthRange * compressionPct

// ───────────────────────────── Virtual position state machine ─────────────────────────────
// Replaces strategy.* order calls. Tracks a paper position so the same
// stop/target/breakeven/zone/time exits drive markers, levels, and alerts.

var int   posState   = 0        // 1 = long, -1 = short, 0 = flat
var float entryPrice = na
var float entryAtr   = na
var int   entryBar   = na
var bool  beTriggered = false

// New signal opens (or reverses) the virtual position.
if longSignal
    posState := 1
    entryPrice := close
    entryAtr := atrVal
    entryBar := bar_index
    beTriggered := false
if shortSignal
    posState := -1
    entryPrice := close
    entryAtr := atrVal
    entryBar := bar_index
    beTriggered := false

// Breakeven trigger.
if posState > 0 and not beTriggered and not na(entryAtr) and high >= entryPrice + entryAtr * breakevenAtrMult
    beTriggered := true
if posState < 0 and not beTriggered and not na(entryAtr) and low <= entryPrice - entryAtr * breakevenAtrMult
    beTriggered := true

longInitialStop  = entryPrice - entryAtr * stopAtrMult
shortInitialStop = entryPrice + entryAtr * stopAtrMult
longTarget       = entryPrice + entryAtr * targetAtrMult
shortTarget      = entryPrice - entryAtr * targetAtrMult
longStopFinal  = useBreakeven and beTriggered ? entryPrice : longInitialStop
shortStopFinal = useBreakeven and beTriggered ? entryPrice : shortInitialStop

// Exit evaluations (only when a fresh signal did NOT just open/flip this bar).
exitLongStop   = posState > 0 and not longSignal  and not shortSignal and low  <= longStopFinal
exitLongTarget = posState > 0 and not longSignal  and not shortSignal and high >= longTarget
exitShortStop  = posState < 0 and not longSignal  and not shortSignal and high >= shortStopFinal
exitShortTarget= posState < 0 and not longSignal  and not shortSignal and low  <= shortTarget
exitLongZone   = useZoneExit and posState > 0 and not longSignal and not shortSignal and isOverbought
exitShortZone  = useZoneExit and posState < 0 and not longSignal and not shortSignal and isOversold
exitTime       = useTimeStop and posState != 0 and not longSignal and not shortSignal and not na(entryBar) and (bar_index - entryBar) >= maxBarsInTrade

anyLongExit  = exitLongStop  or exitLongTarget  or exitLongZone  or (exitTime and posState > 0)
anyShortExit = exitShortStop or exitShortTarget or exitShortZone or (exitTime and posState < 0)

if anyLongExit or anyShortExit
    posState := 0
    beTriggered := false

longTPSignal  = posState > 0 and longWaveActive  and isOverbought and high < high[1]
shortTPSignal = posState < 0 and shortWaveActive and isOversold   and low  > low[1]

// ───────────────────────────── Plotting ─────────────────────────────

plotshape(longSignal,  title="BUY",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(color.green, 0), size=size.small)
plotshape(shortSignal, title="SELL", style=shape.triangledown, location=location.abovebar,
     color=color.new(color.red, 0),   size=size.small)

plotshape(earlyWarnLong,  title="Early BUY warning",  style=shape.diamond, location=location.belowbar,
     color=color.new(color.lime, 20), size=size.tiny)
plotshape(earlyWarnShort, title="Early SELL warning", style=shape.diamond, location=location.abovebar,
     color=color.new(color.orange, 20), size=size.tiny)

plot(showRefLines ? stLine : na, "SuperTrend Band",
     color=isUptrend ? color.new(color.green, 40) : color.new(color.red, 40), style=plot.style_linebr, linewidth=2)

plot(showZoneBands ? waveEquilibrium : na, "Equilibrium (VWMA)", color=color.new(color.gray, 80), display=display.none)

pU1 = plot(showZoneBands ? upperL1 : na, "Wave Upper L1", display=display.none)
pU2 = plot(showZoneBands ? upperL2 : na, "Wave Upper L2", display=display.none)
pU3 = plot(showZoneBands ? upperL3 : na, "Wave Upper L3", display=display.none)
pU4 = plot(showZoneBands ? upperL4 : na, "Wave Upper L4", display=display.none)
pU5 = plot(showZoneBands ? upperL5 : na, "Wave Upper Outer", color=color.new(color.red, 35))

pL1 = plot(showZoneBands ? lowerL1 : na, "Wave Lower L1", display=display.none)
pL2 = plot(showZoneBands ? lowerL2 : na, "Wave Lower L2", display=display.none)
pL3 = plot(showZoneBands ? lowerL3 : na, "Wave Lower L3", display=display.none)
pL4 = plot(showZoneBands ? lowerL4 : na, "Wave Lower L4", display=display.none)
pL5 = plot(showZoneBands ? lowerL5 : na, "Wave Lower Outer", color=color.new(color.green, 35))

fill(pU1, pU2, color=color.new(color.red, 90), title="Upper Gradient 1 (innermost)")
fill(pU2, pU3, color=color.new(color.red, 80), title="Upper Gradient 2")
fill(pU3, pU4, color=color.new(color.red, 68), title="Upper Gradient 3")
fill(pU4, pU5, color=color.new(color.red, 52), title="Upper Gradient 4 (outermost)")

fill(pL1, pL2, color=color.new(color.green, 90), title="Lower Gradient 1 (innermost)")
fill(pL2, pL3, color=color.new(color.green, 80), title="Lower Gradient 2")
fill(pL3, pL4, color=color.new(color.green, 68), title="Lower Gradient 3")
fill(pL4, pL5, color=color.new(color.green, 52), title="Lower Gradient 4 (outermost)")

bgcolor(showCompression and isCompressed ? color.new(color.yellow, 85) : na, title="Compression Highlight")

plotshape(showTpMarkers and newLongWave,  title="Wave Entry (Upper)", style=shape.circle, location=location.abovebar,
     color=color.new(color.red, 20), size=size.tiny)
plotshape(showTpMarkers and newShortWave, title="Wave Entry (Lower)", style=shape.circle, location=location.belowbar,
     color=color.new(color.green, 20), size=size.tiny)
plotshape(showTpMarkers and longTPSignal,  title="TP (Long)",  style=shape.xcross, location=location.abovebar,
     color=color.new(color.orange, 0), size=size.tiny)
plotshape(showTpMarkers and shortTPSignal, title="TP (Short)", style=shape.xcross, location=location.belowbar,
     color=color.new(color.orange, 0), size=size.tiny)

// ───────────────────────────── Virtual trade level plots ─────────────────────────────

tradeEntryPlot  = posState != 0 ? entryPrice : na
tradeStopPlot   = posState > 0 ? longStopFinal  : posState < 0 ? shortStopFinal : na
tradeTargetPlot = posState > 0 ? longTarget     : posState < 0 ? shortTarget    : na

plot(showTradeLevels ? tradeEntryPlot : na, "Entry Price",
     color=color.new(color.gray, 20), style=plot.style_linebr, linewidth=1)
plot(showTradeLevels ? tradeStopPlot : na, "Stop Loss",
     color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showTradeLevels ? tradeTargetPlot : na, "Take Profit",
     color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

if showTradeLevels and longSignal
    label.new(bar_index, longInitialStop, "SL " + str.tostring(longInitialStop, "#.##"),
         style=label.style_label_up, color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)
    label.new(bar_index, longTarget, "TP " + str.tostring(longTarget, "#.##"),
         style=label.style_label_down, color=color.new(color.green, 15), textcolor=color.white, size=size.tiny)
if showTradeLevels and shortSignal
    label.new(bar_index, shortInitialStop, "SL " + str.tostring(shortInitialStop, "#.##"),
         style=label.style_label_down, color=color.new(color.red, 15), textcolor=color.white, size=size.tiny)
    label.new(bar_index, shortTarget, "TP " + str.tostring(shortTarget, "#.##"),
         style=label.style_label_up, color=color.new(color.green, 15), textcolor=color.white, size=size.tiny)

// ───────────────────────────── Alerts ─────────────────────────────

alertcondition(longSignal,  title="Buy Flag",  message="{{ticker}} BUY signal on {{interval}} at {{close}}")
alertcondition(shortSignal, title="Sell Flag", message="{{ticker}} SELL signal on {{interval}} at {{close}}")
alertcondition(earlyWarnLong,  title="Early BUY warning",  message="{{ticker}} approaching BUY flip on {{interval}} at {{close}}")
alertcondition(earlyWarnShort, title="Early SELL warning", message="{{ticker}} approaching SELL flip on {{interval}} at {{close}}")
alertcondition(anyLongExit,  title="Long exit",  message="{{ticker}} LONG exit on {{interval}} at {{close}}")
alertcondition(anyShortExit, title="Short exit", message="{{ticker}} SHORT exit on {{interval}} at {{close}}")

// ───────────────────────────── Dashboard ─────────────────────────────

var table dash = table.new(position.top_right, 2, 7, border_width=1)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "Trend State", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 0, isUptrend ? "Up (long)" : "Down (short)",
         bgcolor=isUptrend ? color.new(color.green, 60) : color.new(color.red, 60))

    table.cell(dash, 0, 1, "Signal Mode", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 1, isRealtime ? "Real-time (leads, repaints)" : "Confirmed (no repaint)",
         bgcolor=isRealtime ? color.new(color.orange, 55) : color.new(color.blue, 60))

    table.cell(dash, 0, 2, "Position", bgcolor=color.gray, text_color=color.white)
    posTxt = posState > 0 ? "Long" : posState < 0 ? "Short" : "Flat"
    posBg  = posState > 0 ? color.new(color.green, 60) : posState < 0 ? color.new(color.red, 60) : color.new(color.gray, 70)
    table.cell(dash, 1, 2, posTxt, bgcolor=posBg)

    table.cell(dash, 0, 3, "ATR", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(atrVal, "#.##"))

    table.cell(dash, 0, 4, "In Session", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 4, inSession ? "Yes" : "No",
         bgcolor=inSession ? color.new(color.green, 60) : color.new(color.red, 60))

    zoneLabel = isOverbought ? "Overbought" : isOversold ? "Oversold" : "Neutral"
    zoneColor = isOverbought ? color.new(color.red, 60) : isOversold ? color.new(color.green, 60) : color.new(color.gray, 70)
    table.cell(dash, 0, 5, "Wave Zone", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 5, zoneLabel, bgcolor=zoneColor)

    table.cell(dash, 0, 6, "ADX", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(adxVal, "#.#"))
