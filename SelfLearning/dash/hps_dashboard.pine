//@version=6
// =============================================================================
//  HPS Quad Dashboard [2m]  —  Module 2 of 4 (Multi-Indicator Dashboard)
//  Runs a condensed "HPS Quad Pro" engine (Quad Divergence + 20/20 Bull Flag
//  entries, 60-10 rotation exits) across the fixed 8-ticker watchlist and
//  renders a status table. Timeframe is LOCKED to 2m via request.security().
//
//  Condensed vs the full HPS Quad Pro:
//    - Keeps: 4 stochastics, EMA 20/50/200, VWAP trend context, Quad
//      Divergence + 20/20 Bull Flag entries, persistent position, 60-10
//      rotation / opposite-signal exits.
//    - Drops: the Daily Pivot line and drawn stop/label management (visual-only
//      in the source; not needed for a per-ticker position readout).
//
//  Normalised bias (shared across all 4 dashboard modules):
//      +1 = LONG   -1 = SHORT   0 = FLAT
// =============================================================================
indicator("HPS Quad Dashboard [2m]", shorttitle="HPS Dash", overlay=true, dynamic_requests=true)

// ============================ CONFIG =========================================
FIXED_TF = "2"   // this module always evaluates HPS on the 2-minute timeframe

grpStoch = "Stochastics"
len1  = input.int(9,  "9-3  %K Length",  minval = 1, group = grpStoch)
sm1   = input.int(3,  "9-3  Smooth",     minval = 1, group = grpStoch)
len2  = input.int(14, "14-3 %K Length",  minval = 1, group = grpStoch)
sm2   = input.int(3,  "14-3 Smooth",     minval = 1, group = grpStoch)
len3  = input.int(40, "40-4 %K Length",  minval = 1, group = grpStoch)
sm3   = input.int(4,  "40-4 Smooth",     minval = 1, group = grpStoch)
len60 = input.int(60, "60-10 %K Length", minval = 1, group = grpStoch)
sm60  = input.int(10, "60-10 Smooth K",  minval = 1, group = grpStoch)
sm60d = input.int(1,  "60-10 Smooth D",  minval = 1, group = grpStoch)

grpLvl = "Stochastic Levels"
obLvl     = input.int(80, "Overbought", minval = 50, maxval = 100, group = grpLvl)
osLvl     = input.int(20, "Oversold",   minval = 0,  maxval = 50,  group = grpLvl)
flagK     = input.int(25, "Bull-Flag 9-3 pullback level", minval = 1, maxval = 50, group = grpLvl)
strongLvl = input.int(85, "60-10 Trend-Strength gate", minval = 50, maxval = 100, group = grpLvl)

grpMA = "Trend / Setups"
ema1Len   = input.int(20,  "EMA 1 (fast)", minval = 1, group = grpMA)
ema2Len   = input.int(50,  "EMA 2 (mid)",  minval = 1, group = grpMA)
ema3Len   = input.int(200, "EMA 3 (slow)", minval = 1, group = grpMA)
useDiv     = input.bool(true, "Enable Quad Divergence", group = grpMA)
pivotLeft  = input.int(5, "Pivot Left",  minval = 1, group = grpMA)
pivotRight = input.int(3, "Pivot Right", minval = 1, group = grpMA)
divExpiry  = input.int(15, "Bars to confirm 9-3 cross after divergence", minval = 1, group = grpMA)
useFlag      = input.bool(true, "Enable 20/20 Bull Flag", group = grpMA)
atrLen       = input.int(14, "ATR Length", minval = 1, group = grpMA)
atrMult      = input.float(1.5, "Aggressive-move ATR multiple", minval = 0.1, step = 0.1, group = grpMA)
flagLookback = input.int(10, "Aggressive-move lookback (bars)", minval = 2, group = grpMA)

grpSess = "Session Filter"
useSession = input.bool(true, "Only signal during NY session", group = grpSess)
sess       = input.session("0930-1600", "Session", group = grpSess)
tz         = input.string("America/New_York", "Timezone", group = grpSess)

grpSym = "Watchlist"
symText = input.text_area("AMEX:SPY\nNASDAQ:QQQ\nAMEX:IWM\nNASDAQ:AAPL\nNASDAQ:GOOGL\nNASDAQ:NVDA\nNASDAQ:TSLA\nNASDAQ:MSFT", "Tickers (one per line or comma-separated)", group = grpSym)

grpUI = "Dashboard"
tblPos  = input.string("Top Left", "Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpUI)
txtSize = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal"], group = grpUI)

// ============================ STOCH HELPERS (top-level) ======================
f_fastStoch(int len, int smoothK) => ta.sma(ta.stoch(close, high, low, len), smoothK)
f_fullStoch(int len, int smoothK, int smoothD) => ta.sma(ta.sma(ta.stoch(close, high, low, len), smoothK), smoothD)

// ============================ PER-SYMBOL HPS ENGINE ==========================
// Returns: [bias(-1/0/1), setupCode(0 none/1 div/2 flag), k1, k60, trendCode, price]
//   trendCode: 2 strong-up, 1 up, -1 down, -2 strong-down, 0 mixed
f_hps() =>
    k1  = f_fastStoch(len1, sm1)
    k2  = f_fastStoch(len2, sm2)
    k3  = f_fastStoch(len3, sm3)
    k60 = f_fullStoch(len60, sm60, sm60d)

    ema20  = ta.ema(close, ema1Len)
    ema50  = ta.ema(close, ema2Len)
    ema200 = ta.ema(close, ema3Len)
    vwapVal = ta.vwap
    atr    = ta.atr(atrLen)

    tSess    = time(timeframe.period, sess, tz)
    inSess   = not na(tSess)
    sessOK   = (not useSession) or inSess
    confirmed = barstate.isconfirmed

    quadOversold   = k1 < osLvl and k2 < osLvl and k3 < osLvl and k60 < osLvl
    quadOverbought = k1 > obLvl and k2 > obLvl and k3 > obLvl and k60 > obLvl

    // ---- Setup 1: Quad Divergence ----
    plK = ta.pivotlow(k1, pivotLeft, pivotRight)
    phK = ta.pivothigh(k1, pivotLeft, pivotRight)

    var float prevPLval   = na
    var float prevPLprice = na
    var bool  prevPLquad  = false
    var float prevPHval   = na
    var float prevPHprice = na
    var bool  prevPHquad  = false
    var int   divLongBar  = na
    var int   divShortBar = na

    if not na(plK)
        curPrice = low[pivotRight]
        curQuad  = quadOversold[pivotRight]
        if not na(prevPLval) and curPrice <= prevPLprice and plK > prevPLval and prevPLquad
            divLongBar := bar_index
        prevPLval   := plK
        prevPLprice := curPrice
        prevPLquad  := curQuad

    if not na(phK)
        curPrice = high[pivotRight]
        curQuad  = quadOverbought[pivotRight]
        if not na(prevPHval) and curPrice >= prevPHprice and phK < prevPHval and prevPHquad
            divShortBar := bar_index
        prevPHval   := phK
        prevPHprice := curPrice
        prevPHquad  := curQuad

    divLongFire  = useDiv and sessOK and confirmed and not na(divLongBar)  and (bar_index - divLongBar  <= divExpiry) and ta.crossover(k1, osLvl)
    divShortFire = useDiv and sessOK and confirmed and not na(divShortBar) and (bar_index - divShortBar <= divExpiry) and ta.crossunder(k1, obLvl)
    if divLongFire
        divLongBar := na
    if divShortFire
        divShortBar := na

    // ---- Setup 2: 20/20 Bull Flag ----
    trendUp = ema20 > ema50 and close > ema50
    trendDn = ema20 < ema50 and close < ema50
    distAbove = close - ema20
    distBelow = ema20 - close
    aggressiveUp = ta.highest(distAbove, flagLookback) >= atrMult * atr
    aggressiveDn = ta.highest(distBelow, flagLookback) >= atrMult * atr
    pullbackUp = low  <= ema20
    pullbackDn = high >= ema20

    var bool flagLongUsed  = false
    var bool flagShortUsed = false
    if k1 >= obLvl or not trendUp
        flagLongUsed := false
    if k1 <= osLvl or not trendDn
        flagShortUsed := false

    flagLongGates = trendUp and aggressiveUp and k60 >= strongLvl and k1 <= flagK
    flagDnGates   = trendDn and aggressiveDn and k60 <= (100 - strongLvl) and k1 >= (100 - flagK)
    flagLongTrig  = flagLongGates and (pullbackUp or k1 <= osLvl)
    flagDnTrig    = flagDnGates   and (pullbackDn or k1 >= obLvl)
    flagLongFire  = useFlag and sessOK and confirmed and flagLongTrig and not flagLongUsed
    flagShortFire = useFlag and sessOK and confirmed and flagDnTrig   and not flagShortUsed
    if flagLongFire
        flagLongUsed := true
    if flagShortFire
        flagShortUsed := true

    longFire  = divLongFire  or flagLongFire
    shortFire = divShortFire or flagShortFire

    // ---- Persistent position with 60-10 rotation / opposite-signal exits ----
    var int    tradeDir  = 0
    var int    setupCode = 0
    strongLong  = close > ema200 and close > vwapVal
    strongShort = close < ema200 and close < vwapVal
    exitLong  = confirmed and tradeDir == 1  and (ta.crossunder(k60, strongLvl) or shortFire)
    exitShort = confirmed and tradeDir == -1 and (ta.crossover(k60, 100 - strongLvl) or longFire)
    if exitLong
        tradeDir := 0
        setupCode := 0
    if exitShort
        tradeDir := 0
        setupCode := 0
    if longFire
        tradeDir := 1
        setupCode := divLongFire ? 1 : 2
    if shortFire
        tradeDir := -1
        setupCode := divShortFire ? 1 : 2

    trendCode = strongLong ? 2 : strongShort ? -2 : trendUp ? 1 : trendDn ? -1 : 0
    [tradeDir, setupCode, k1, k60, trendCode, close]

// ============================ PARSE WATCHLIST ================================
f_parse(string raw) =>
    tmp  = str.replace_all(raw, ",", "\n")
    tmp2 = str.replace_all(tmp, "\r", "")
    tmp3 = str.replace_all(tmp2, " ", "")
    parts = str.split(tmp3, "\n")
    out = array.new_string()
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            p = array.get(parts, i)
            if str.length(p) > 0
                array.push(out, str.upper(p))
    out

symbols = f_parse(symText)
n = array.size(symbols)

// ============================ FETCH (dynamic loop, LOCKED 2m) ================
var names  = array.new_string()
var biases = array.new_int()
var setups = array.new_int()
var k1s    = array.new_float()
var k60s   = array.new_float()
var trends = array.new_int()
var prices = array.new_float()

array.clear(names)
array.clear(biases)
array.clear(setups)
array.clear(k1s)
array.clear(k60s)
array.clear(trends)
array.clear(prices)

if n > 0
    for i = 0 to n - 1
        sym = array.get(symbols, i)
        [b, sc, k1, k60, tc, px] = request.security(sym, FIXED_TF, f_hps(), ignore_invalid_symbol = true)
        array.push(names, sym)
        array.push(biases, na(b) ? 0 : b)
        array.push(setups, na(sc) ? 0 : sc)
        array.push(k1s, k1)
        array.push(k60s, k60)
        array.push(trends, na(tc) ? 0 : tc)
        array.push(prices, px)

// ============================ DASHBOARD HELPERS ==============================
f_pos() =>
    tblPos == "Top Left"     ? position.top_left     :
     tblPos == "Bottom Right" ? position.bottom_right :
     tblPos == "Bottom Left"  ? position.bottom_left  :
     position.top_right

f_size() =>
    txtSize == "Tiny" ? size.tiny : txtSize == "Normal" ? size.normal : size.small

f_cleanName(string s) =>
    arr = str.split(s, ":")
    array.size(arr) > 1 ? array.get(arr, 1) : s

f_biasTxt(int b)  => b == 1 ? "LONG" : b == -1 ? "SHORT" : "FLAT"
f_biasCol(int b)  => b == 1 ? color.green : b == -1 ? color.red : color.gray
f_setupTxt(int s) => s == 1 ? "Div" : s == 2 ? "Flag" : "-"
f_trendTxt(int t) => t == 2 ? "STR UP" : t == 1 ? "UP" : t == -1 ? "DN" : t == -2 ? "STR DN" : "MIX"
f_trendCol(int t) => t > 0 ? color.green : t < 0 ? color.red : color.gray
f_kCol(float v)   => v >= obLvl ? color.red : v <= osLvl ? color.green : color.gray

// ============================ RENDER DASHBOARD ===============================
var table dash = na
if barstate.islast
    if not na(dash)
        table.delete(dash)
    rows = array.size(names) + 1
    dash := table.new(f_pos(), 6, rows, border_width = 1, frame_color = color.gray, frame_width = 1)
    hb = color.new(color.purple, 0)
    table.cell(dash, 0, 0, "HPS 2m", text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 1, 0, "Pos",    text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 2, 0, "Setup",  text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 3, 0, "Trend",  text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 4, 0, "9-3",    text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 5, 0, "60-10",  text_color = color.white, bgcolor = hb, text_size = f_size())

    if array.size(names) > 0
        for i = 0 to array.size(names) - 1
            r  = i + 1
            b  = array.get(biases, i)
            sc = array.get(setups, i)
            k1 = array.get(k1s, i)
            k60= array.get(k60s, i)
            tc = array.get(trends, i)
            table.cell(dash, 0, r, f_cleanName(array.get(names, i)), text_color = color.white, text_size = f_size())
            table.cell(dash, 1, r, f_biasTxt(b), text_color = color.white, bgcolor = color.new(f_biasCol(b), 55), text_size = f_size())
            table.cell(dash, 2, r, f_setupTxt(sc), text_color = color.white, text_size = f_size())
            table.cell(dash, 3, r, f_trendTxt(tc), text_color = f_trendCol(tc), text_size = f_size())
            table.cell(dash, 4, r, na(k1)  ? "n/a" : str.tostring(k1,  "#.0"), text_color = f_kCol(k1),  text_size = f_size())
            table.cell(dash, 5, r, na(k60) ? "n/a" : str.tostring(k60, "#.0"), text_color = k60 >= strongLvl ? color.green : k60 <= (100 - strongLvl) ? color.red : color.gray, text_size = f_size())
