//@version=6
// =============================================================================
//  Confluence Engine  —  Alert brain for the Multi-Indicator Dashboard
//  Recomputes a CONDENSED bias for all four indicators across the fixed
//  8-ticker watchlist, renders a master agreement table, and fires ONE push
//  alert per ticker when >= N indicators agree on direction.
//
//  request.security() budget (Premium cap = 40):
//      ORB @5m  (1) + HPS @2m (1) + Casey-lite @2m (1) + ERS @5m (1)
//      = 4 calls x 8 tickers = 32  (comfortable headroom)
//
//  Fidelity note: the four biases here are CONDENSED, single-request versions
//  for cheap agreement detection. The four visual dashboard modules
//  (orb/hps/casey/ema_rsi_stoch_dashboard.pine) are the full-fidelity source
//  of truth. In particular the Casey bias here is a 2m-only approximation
//  (trend stack + reclaim of the 13 EMA after a dip) and OMITS the 15m break
//  confirmation and the HPS Daily pivot, by design.
//
//  ALERTS: right-click this indicator -> Add alert -> Condition = "Confluence
//  Engine" -> "Any alert() function call" -> enable Push Notifications.
// =============================================================================
indicator("Confluence Engine", shorttitle="Confluence", overlay=true, dynamic_requests=true)

// ============================ CONFIG =========================================
grpC = "Confluence Rule"
minAgree   = input.int(2, "Min indicators that must agree", minval = 2, maxval = 4, group = grpC)
requireNoOpp = input.bool(true, "Require zero opposing indicators", group = grpC)
alertOnClose = input.bool(true, "Only fire alerts on bar close", group = grpC)

grpSym = "Watchlist"
symText = input.text_area("AMEX:SPY\nNASDAQ:QQQ\nAMEX:IWM\nNASDAQ:AAPL\nNASDAQ:GOOGL\nNASDAQ:NVDA\nNASDAQ:TSLA\nNASDAQ:MSFT", "Tickers (one per line or comma-separated)", group = grpSym)

grpSess = "Sessions"
useSession = input.bool(true, "HPS: only signal during NY session", group = grpSess)
sess       = input.session("0930-1600", "NY Session", group = grpSess)
tz         = input.string("America/New_York", "Timezone", group = grpSess)

grpUI = "Dashboard"
tblPos  = input.string("Top Right", "Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpUI)
txtSize = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal"], group = grpUI)
timeFmt = input.string("HH:mm", "Signal Time Format", options = ["HH:mm", "HH:mm:ss", "MM-dd HH:mm"], group = grpUI)

TF_FAST = "2"
TF_SLOW = "5"

// ============================ CONDENSED BIAS ENGINES =========================
// ---- ORB @5m : returns [bias, price] ----
f_orb_bias() =>
    orMs = 15 * 60 * 1000
    t       = time(timeframe.period, sess, tz)
    inSess  = not na(t)
    newSess = inSess and (na(t[1]) or not inSess[1])
    var float orH = na
    var float orL = na
    var int   sessOpen = na
    var bool  locked = false
    var int   dir = 0
    var bool  pUp = false
    var bool  pDn = false
    var float cH = na
    var float cL = na
    var int   cBar = na
    if newSess
        orH := high
        orL := low
        sessOpen := t
        locked := false
        dir := 0
        pUp := false
        pDn := false
    inWindow = inSess and not na(sessOpen) and (t - sessOpen < orMs)
    if inWindow and not newSess
        orH := math.max(orH, high)
        orL := math.min(orL, low)
    if (not locked) and not na(orH) and not na(sessOpen) and (t - sessOpen >= orMs)
        locked := true
    crossUp = locked and inSess and close > orH and close[1] <= orH
    crossDn = locked and inSess and close < orL and close[1] >= orL
    if crossUp
        pUp := true
        pDn := false
        cH := high
        cBar := bar_index
    if crossDn
        pDn := true
        pUp := false
        cL := low
        cBar := bar_index
    if pUp and bar_index > cBar and close > open and close > cH
        dir := 1
        pUp := false
    if pDn and bar_index > cBar and close < open and close < cL
        dir := -1
        pDn := false
    status = not locked ? 0 : close > orH ? 1 : close < orL ? -1 : 0
    int bias = dir != 0 ? dir : status
    [bias, close]

// ---- HPS @2m : returns bias (persistent Div + Bull-Flag position) ----
f_hps_fast(int len, int sk) => ta.sma(ta.stoch(close, high, low, len), sk)
f_hps_full(int len, int sk, int sd) => ta.sma(ta.sma(ta.stoch(close, high, low, len), sk), sd)
f_hps_bias() =>
    k1  = f_hps_fast(9, 3)
    k2  = f_hps_fast(14, 3)
    k3  = f_hps_fast(40, 4)
    k60 = f_hps_full(60, 10, 1)
    ema20  = ta.ema(close, 20)
    ema50  = ta.ema(close, 50)
    ema200 = ta.ema(close, 200)
    vwapVal = ta.vwap
    atr = ta.atr(14)
    sessOK = (not useSession) or not na(time(timeframe.period, sess, tz))
    confirmed = barstate.isconfirmed
    qOS = k1 < 20 and k2 < 20 and k3 < 20 and k60 < 20
    qOB = k1 > 80 and k2 > 80 and k3 > 80 and k60 > 80

    plK = ta.pivotlow(k1, 5, 3)
    phK = ta.pivothigh(k1, 5, 3)
    var float pPLv = na
    var float pPLp = na
    var bool  pPLq = false
    var float pPHv = na
    var float pPHp = na
    var bool  pPHq = false
    var int   dLB = na
    var int   dSB = na
    if not na(plK)
        cp = low[3]
        cq = qOS[3]
        if not na(pPLv) and cp <= pPLp and plK > pPLv and pPLq
            dLB := bar_index
        pPLv := plK
        pPLp := cp
        pPLq := cq
    if not na(phK)
        cp = high[3]
        cq = qOB[3]
        if not na(pPHv) and cp >= pPHp and phK < pPHv and pPHq
            dSB := bar_index
        pPHv := phK
        pPHp := cp
        pPHq := cq
    divLong  = sessOK and confirmed and not na(dLB) and (bar_index - dLB <= 15) and ta.crossover(k1, 20)
    divShort = sessOK and confirmed and not na(dSB) and (bar_index - dSB <= 15) and ta.crossunder(k1, 80)
    if divLong
        dLB := na
    if divShort
        dSB := na

    trendUp = ema20 > ema50 and close > ema50
    trendDn = ema20 < ema50 and close < ema50
    aggUp = ta.highest(close - ema20, 10) >= 1.5 * atr
    aggDn = ta.highest(ema20 - close, 10) >= 1.5 * atr
    var bool flUp = false
    var bool flDn = false
    if k1 >= 80 or not trendUp
        flUp := false
    if k1 <= 20 or not trendDn
        flDn := false
    flagLong  = sessOK and confirmed and trendUp and aggUp and k60 >= 85 and k1 <= 25 and (low <= ema20 or k1 <= 20) and not flUp
    flagShort = sessOK and confirmed and trendDn and aggDn and k60 <= 15 and k1 >= 75 and (high >= ema20 or k1 >= 80) and not flDn
    if flagLong
        flUp := true
    if flagShort
        flDn := true

    longFire  = divLong  or flagLong
    shortFire = divShort or flagShort
    var int tradeDir = 0
    exitLong  = confirmed and tradeDir == 1  and (ta.crossunder(k60, 85) or shortFire)
    exitShort = confirmed and tradeDir == -1 and (ta.crossover(k60, 15) or longFire)
    if exitLong
        tradeDir := 0
    if exitShort
        tradeDir := 0
    if longFire
        tradeDir := 1
    if shortFire
        tradeDir := -1
    tradeDir

// ---- Casey-lite @2m : trend stack + reclaim of 13 EMA after a recent dip ----
f_casey_bias() =>
    e1 = ta.ema(close, 13)
    e2 = ta.ema(close, 48)
    e3 = ta.ema(close, 200)
    atr = ta.atr(14)
    tol = atr * 0.25
    bull = e1 > e2 and e2 > e3
    bear = e1 < e2 and e2 < e3
    dipL = ta.barssince(low  <= e1 + tol) <= 6
    dipS = ta.barssince(high >= e1 - tol) <= 6
    int bias = 0
    if bull and close > e1 and dipL
        bias := 1
    else if bear and close < e1 and dipS
        bias := -1
    bias

// ---- ERS @5m : persistent latched BUY/SELL bias ----
f_ers_bias() =>
    ha_close = (open + high + low + close) / 4
    var float ha_open = na
    ha_open := na(ha_open[1]) ? (open + close) / 2 : (ha_open[1] + ha_close[1]) / 2
    ha_high = math.max(high, math.max(ha_open, ha_close))
    ha_low  = math.min(low,  math.min(ha_open, ha_close))
    ema_h = ta.ema(high, 20)
    ema_l = ta.ema(low, 20)
    rsi_val = ta.rsi(close, 14)
    sraw = ta.stoch(ha_close, ha_high, ha_low, 14)
    k = ta.sma(sraw, 3)
    d = ta.sma(k, 3)
    buy  = ha_close > ema_h and rsi_val > 50 and ta.crossover(k, d) and k < 80
    sell = ha_close < ema_l and rsi_val < 50 and ta.crossunder(k, d) and k > 20
    var int bias = 0
    if buy
        bias := 1
    else if sell
        bias := -1
    else if bias == 1 and ha_close < ema_l
        bias := 0
    else if bias == -1 and ha_close > ema_h
        bias := 0
    bias

// ============================ PARSE WATCHLIST ================================
f_parse(string raw) =>
    tmp  = str.replace_all(raw, ",", "\n")
    tmp2 = str.replace_all(tmp, "\r", "")
    tmp3 = str.replace_all(tmp2, " ", "")
    parts = str.split(tmp3, "\n")
    out = array.new_string()
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            p = array.get(parts, i)
            if str.length(p) > 0
                array.push(out, str.upper(p))
    out

symbols = f_parse(symText)
n = array.size(symbols)

// ============================ HELPERS (declared before use) =================
f_clean(string s) =>
    arr = str.split(s, ":")
    array.size(arr) > 1 ? array.get(arr, 1) : s

f_names(int o, int h, int c, int e, int dir) =>
    parts = array.new_string()
    if o == dir
        array.push(parts, "ORB")
    if h == dir
        array.push(parts, "HPS")
    if c == dir
        array.push(parts, "Casey")
    if e == dir
        array.push(parts, "ERS")
    array.join(parts, ",")

// ============================ PERSISTENT EDGE STATE ==========================
var prevLong  = array.new_bool()
var prevShort = array.new_bool()
var lastSig   = array.new_int()    // bar time of the most recent confluence per ticker (na = none yet)
if array.size(prevLong) != n
    array.clear(prevLong)
    array.clear(prevShort)
    array.clear(lastSig)
    if n > 0
        for i = 0 to n - 1
            array.push(prevLong, false)
            array.push(prevShort, false)
            array.push(lastSig, na)

// ============================ RENDER ARRAYS =================================
var names = array.new_string()
var bORB  = array.new_int()
var bHPS  = array.new_int()
var bCAS  = array.new_int()
var bERS  = array.new_int()
var agr   = array.new_int()   // signed agreement: + long count, - short count, 0 none

array.clear(names)
array.clear(bORB)
array.clear(bHPS)
array.clear(bCAS)
array.clear(bERS)
array.clear(agr)

fireOK = (not alertOnClose) or barstate.isconfirmed

if n > 0
    for i = 0 to n - 1
        sym = array.get(symbols, i)
        [ob, px]  = request.security(sym, TF_SLOW, f_orb_bias(),  ignore_invalid_symbol = true)
        hb        = request.security(sym, TF_FAST, f_hps_bias(),  ignore_invalid_symbol = true)
        cb        = request.security(sym, TF_FAST, f_casey_bias(),ignore_invalid_symbol = true)
        eb        = request.security(sym, TF_SLOW, f_ers_bias(),  ignore_invalid_symbol = true)
        int obi = na(ob) ? 0 : ob
        int hbi = na(hb) ? 0 : hb
        int cbi = na(cb) ? 0 : cb
        int ebi = na(eb) ? 0 : eb

        longCount  = (obi == 1 ? 1 : 0) + (hbi == 1 ? 1 : 0) + (cbi == 1 ? 1 : 0) + (ebi == 1 ? 1 : 0)
        shortCount = (obi == -1 ? 1 : 0) + (hbi == -1 ? 1 : 0) + (cbi == -1 ? 1 : 0) + (ebi == -1 ? 1 : 0)

        bullConf = longCount  >= minAgree and (not requireNoOpp or shortCount == 0)
        bearConf = shortCount >= minAgree and (not requireNoOpp or longCount  == 0)

        // rising-edge alerts
        pL = array.get(prevLong, i)
        pS = array.get(prevShort, i)
        sigTime = str.format_time(time, timeFmt, tz)
        if fireOK and bullConf and not pL
            names_up = f_names(obi, hbi, cbi, ebi, 1)
            array.set(lastSig, i, time)
            alert("▲ CONFLUENCE " + f_clean(sym) + " — " + str.tostring(longCount) + " LONG (" + names_up + ") @ " + str.tostring(px, format.mintick) + " [" + sigTime + "]", alert.freq_once_per_bar_close)
        if fireOK and bearConf and not pS
            names_dn = f_names(obi, hbi, cbi, ebi, -1)
            array.set(lastSig, i, time)
            alert("▼ CONFLUENCE " + f_clean(sym) + " — " + str.tostring(shortCount) + " SHORT (" + names_dn + ") @ " + str.tostring(px, format.mintick) + " [" + sigTime + "]", alert.freq_once_per_bar_close)
        array.set(prevLong, i, bullConf)
        array.set(prevShort, i, bearConf)

        array.push(names, sym)
        array.push(bORB, obi)
        array.push(bHPS, hbi)
        array.push(bCAS, cbi)
        array.push(bERS, ebi)
        array.push(agr, bullConf ? longCount : bearConf ? -shortCount : 0)

// ============================ HELPERS ========================================
f_pos() =>
    tblPos == "Top Left"     ? position.top_left     :
     tblPos == "Bottom Right" ? position.bottom_right :
     tblPos == "Bottom Left"  ? position.bottom_left  :
     position.top_right

f_size() =>
    txtSize == "Tiny" ? size.tiny : txtSize == "Normal" ? size.normal : size.small

f_cell(int b) => b == 1 ? "L" : b == -1 ? "S" : "·"
f_cellCol(int b) => b == 1 ? color.green : b == -1 ? color.red : color.new(color.gray, 40)

// ============================ RENDER MASTER TABLE ============================
var table dash = na
if barstate.islast
    if not na(dash)
        table.delete(dash)
    rows = array.size(names) + 1
    dash := table.new(f_pos(), 7, rows, border_width = 1, frame_color = color.gray, frame_width = 1)
    hb2 = color.new(color.blue, 0)
    table.cell(dash, 0, 0, "Ticker", text_color = color.white, bgcolor = hb2, text_size = f_size())
    table.cell(dash, 1, 0, "ORB",   text_color = color.white, bgcolor = hb2, text_size = f_size())
    table.cell(dash, 2, 0, "HPS",   text_color = color.white, bgcolor = hb2, text_size = f_size())
    table.cell(dash, 3, 0, "Casey", text_color = color.white, bgcolor = hb2, text_size = f_size())
    table.cell(dash, 4, 0, "ERS",   text_color = color.white, bgcolor = hb2, text_size = f_size())
    table.cell(dash, 5, 0, "Agree", text_color = color.white, bgcolor = hb2, text_size = f_size())
    table.cell(dash, 6, 0, "Time",  text_color = color.white, bgcolor = hb2, text_size = f_size())

    if array.size(names) > 0
        for i = 0 to array.size(names) - 1
            r  = i + 1
            o  = array.get(bORB, i)
            h  = array.get(bHPS, i)
            c  = array.get(bCAS, i)
            e  = array.get(bERS, i)
            a  = array.get(agr, i)
            agTxt = a > 0 ? str.tostring(a) + "L" : a < 0 ? str.tostring(-a) + "S" : "-"
            agCol = a > 0 ? color.new(color.green, 20) : a < 0 ? color.new(color.red, 20) : color.new(color.gray, 60)
            tRaw  = array.size(lastSig) > i ? array.get(lastSig, i) : na
            tTxt  = na(tRaw) ? "-" : str.format_time(tRaw, timeFmt, tz)
            table.cell(dash, 0, r, f_clean(array.get(names, i)), text_color = color.white, text_size = f_size())
            table.cell(dash, 1, r, f_cell(o), text_color = f_cellCol(o), text_size = f_size())
            table.cell(dash, 2, r, f_cell(h), text_color = f_cellCol(h), text_size = f_size())
            table.cell(dash, 3, r, f_cell(c), text_color = f_cellCol(c), text_size = f_size())
            table.cell(dash, 4, r, f_cell(e), text_color = f_cellCol(e), text_size = f_size())
            table.cell(dash, 5, r, agTxt, text_color = color.white, bgcolor = agCol, text_size = f_size())
            table.cell(dash, 6, r, tTxt, text_color = color.new(color.white, 20), text_size = f_size())
