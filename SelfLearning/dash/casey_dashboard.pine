//@version=6
// =============================================================================
//  Casey Level Break Dashboard [2m]  —  Module 3 of 4 (Multi-Indicator Dash)
//  Runs the "Level Break + EMA Pullback [13/48/200]" logic across the fixed
//  8-ticker watchlist and renders a status table. Entry-timeframe context is
//  LOCKED to 2m; the level break is confirmed on the 15m close.
//
//  Per symbol this module issues THREE request.security() calls:
//    1) 2m  bundle : EMA 13/48/200, PMH/PML (built live), price, dip-to-13 flag
//    2) D   bundle : prior-day high/low (PDH/PDL)
//    3) 15m close  : last CLOSED 15m close for non-repainting break confirmation
//  = 3 calls x 8 tickers = 24 (within the 40-call limit).
//
//  Normalised bias (shared across all 4 dashboard modules):
//      +1 = LONG   -1 = SHORT   0 = NEUTRAL
//    LONG  = bullish stack + 15m break above PMH/PDH + price reclaimed 13 EMA
//    SHORT = bearish stack + 15m break below PML/PDL + price below 13 EMA
// =============================================================================
indicator("Casey Level Break Dashboard [2m]", shorttitle="Casey Dash", overlay=true, dynamic_requests=true)

// ============================ CONFIG =========================================
FIXED_TF = "2"    // entry-timeframe context
confTF   = input.timeframe("15", "Confirmation Timeframe (level break close)")

grpEMA = "EMAs"
len1  = input.int(13,  "Fast EMA (13)",  minval = 1, group = grpEMA)
len2  = input.int(48,  "Mid EMA (48)",   minval = 1, group = grpEMA)
len3  = input.int(200, "Slow EMA (200)", minval = 1, group = grpEMA)

grpLvl = "Key Levels / Break"
armPMH = input.bool(true, "Bull break: 15m close ABOVE PMH", group = grpLvl)
armPDH = input.bool(true, "Bull break: 15m close ABOVE PDH", group = grpLvl)
armPML = input.bool(true, "Bear break: 15m close BELOW PML", group = grpLvl)
armPDL = input.bool(true, "Bear break: 15m close BELOW PDL", group = grpLvl)
pmSess = input.session("0400-0930", "Pre-Market Window", group = grpLvl)
tz     = input.string("America/New_York", "Session Timezone", group = grpLvl)

grpEntry = "Pullback / Entry"
tolMode = input.string("ATR", "13 EMA Touch Tolerance", options = ["ATR", "Percent"], group = grpEntry)
atrLen  = input.int(14, "ATR Length", minval = 1, group = grpEntry)
atrMult = input.float(0.25, "ATR Multiple", minval = 0.0, step = 0.05, group = grpEntry)
pctTol  = input.float(0.10, "Percent Tolerance (%)", minval = 0.0, step = 0.05, group = grpEntry)
holdMid = input.bool(true, "Require price to hold beyond the 48 EMA", group = grpEntry)
useRTH  = input.bool(true, "Only qualify entries during Regular Hours", group = grpEntry)
rthSess = input.session("0930-1600", "Regular Session", group = grpEntry)

grpSym = "Watchlist"
symText = input.text_area("AMEX:SPY\nNASDAQ:QQQ\nAMEX:IWM\nNASDAQ:AAPL\nNASDAQ:GOOGL\nNASDAQ:NVDA\nNASDAQ:TSLA\nNASDAQ:MSFT", "Tickers (one per line or comma-separated)", group = grpSym)

grpUI = "Dashboard"
tblPos  = input.string("Bottom Left", "Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpUI)
txtSize = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal"], group = grpUI)

// ============================ PER-SYMBOL 2m BUNDLE ===========================
// Returns: [ema1, ema2, ema3, pmh, pml, price, low, high, tolVal, dipLong,
//           dipShort, inRTH, inPM]
f_2m() =>
    ema1 = ta.ema(close, len1)
    ema2 = ta.ema(close, len2)
    ema3 = ta.ema(close, len3)
    atr  = ta.atr(atrLen)
    tolVal = tolMode == "ATR" ? atr * atrMult : close * pctTol / 100.0

    inPM  = not na(time(timeframe.period, pmSess, tz))
    newPM = inPM and not inPM[1]
    var float pmh = na
    var float pml = na
    if newPM
        pmh := high
        pml := low
    else if inPM
        pmh := math.max(pmh, high)
        pml := math.min(pml, low)

    inRTH = not na(time(timeframe.period, rthSess, tz))
    // recent dip into the 13 EMA (within tolerance) over the last few bars
    dipLong  = low  <= ema1 + tolVal
    dipShort = high >= ema1 - tolVal
    [ema1, ema2, ema3, pmh, pml, close, low, high, tolVal, dipLong, dipShort, inRTH, inPM]

// ============================ PARSE WATCHLIST ================================
f_parse(string raw) =>
    tmp  = str.replace_all(raw, ",", "\n")
    tmp2 = str.replace_all(tmp, "\r", "")
    tmp3 = str.replace_all(tmp2, " ", "")
    parts = str.split(tmp3, "\n")
    out = array.new_string()
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            p = array.get(parts, i)
            if str.length(p) > 0
                array.push(out, str.upper(p))
    out

symbols = f_parse(symText)
n = array.size(symbols)

// ============================ FETCH (dynamic loop) ===========================
var names   = array.new_string()
var biases  = array.new_int()
var trends  = array.new_int()   // 1 bull stack, -1 bear stack, 0 mixed
var brkCode = array.new_int()   // 1 bull break, -1 bear break, 0 none
var pbState = array.new_int()   // 1 long dip, -1 short dip, 0 none
var prices  = array.new_float()

array.clear(names)
array.clear(biases)
array.clear(trends)
array.clear(brkCode)
array.clear(pbState)
array.clear(prices)

if n > 0
    for i = 0 to n - 1
        sym = array.get(symbols, i)
        [e1, e2, e3, pmh, pml, px, lo, hi, tol, dipL, dipS, inRTH, inPM] = request.security(sym, FIXED_TF, f_2m(), ignore_invalid_symbol = true)
        [pdh, pdl] = request.security(sym, "D", [high[1], low[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
        htfClose = request.security(sym, confTF, close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

        bullStack = e1 > e2 and e2 > e3
        bearStack = e1 < e2 and e2 < e3

        brkPMH = armPMH and not na(pmh) and not na(htfClose) and htfClose > pmh
        brkPDH = armPDH and not na(pdh) and not na(htfClose) and htfClose > pdh
        brkPML = armPML and not na(pml) and not na(htfClose) and htfClose < pml
        brkPDL = armPDL and not na(pdl) and not na(htfClose) and htfClose < pdl
        bullArmed = brkPMH or brkPDH
        bearArmed = brkPML or brkPDL

        tradeOK = (not useRTH) or inRTH
        midOKlong  = (not holdMid) or px > e2
        midOKshort = (not holdMid) or px < e2

        int bias = 0
        if bullArmed and bullStack and tradeOK and px > e1 and midOKlong
            bias := 1
        else if bearArmed and bearStack and tradeOK and px < e1 and midOKshort
            bias := -1

        int tc = bullStack ? 1 : bearStack ? -1 : 0
        int bc = bullArmed ? 1 : bearArmed ? -1 : 0
        int ps = (bias == 0 and bullArmed and bullStack and dipL) ? 1 : (bias == 0 and bearArmed and bearStack and dipS) ? -1 : 0

        array.push(names, sym)
        array.push(biases, bias)
        array.push(trends, tc)
        array.push(brkCode, bc)
        array.push(pbState, ps)
        array.push(prices, px)

// ============================ DASHBOARD HELPERS ==============================
f_pos() =>
    tblPos == "Top Left"     ? position.top_left     :
     tblPos == "Bottom Right" ? position.bottom_right :
     tblPos == "Bottom Left"  ? position.bottom_left  :
     position.top_right

f_size() =>
    txtSize == "Tiny" ? size.tiny : txtSize == "Normal" ? size.normal : size.small

f_cleanName(string s) =>
    arr = str.split(s, ":")
    array.size(arr) > 1 ? array.get(arr, 1) : s

f_biasTxt(int b)  => b == 1 ? "LONG" : b == -1 ? "SHORT" : "-"
f_biasCol(int b)  => b == 1 ? color.green : b == -1 ? color.red : color.gray
f_trendTxt(int t) => t == 1 ? "BULL" : t == -1 ? "BEAR" : "MIX"
f_brkTxt(int b)   => b == 1 ? "▲ brk" : b == -1 ? "▼ brk" : "-"
f_pbTxt(int p)    => p == 1 ? "long dip" : p == -1 ? "short dip" : "-"

// ============================ RENDER DASHBOARD ===============================
var table dash = na
if barstate.islast
    if not na(dash)
        table.delete(dash)
    rows = array.size(names) + 1
    dash := table.new(f_pos(), 6, rows, border_width = 1, frame_color = color.gray, frame_width = 1)
    hb = color.new(color.teal, 0)
    table.cell(dash, 0, 0, "Casey 2m", text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 1, 0, "Pos",   text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 2, 0, "Trend", text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 3, 0, "Break", text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 4, 0, "Pullbk",text_color = color.white, bgcolor = hb, text_size = f_size())
    table.cell(dash, 5, 0, "Last",  text_color = color.white, bgcolor = hb, text_size = f_size())

    if array.size(names) > 0
        for i = 0 to array.size(names) - 1
            r  = i + 1
            b  = array.get(biases, i)
            tc = array.get(trends, i)
            bc = array.get(brkCode, i)
            ps = array.get(pbState, i)
            px = array.get(prices, i)
            table.cell(dash, 0, r, f_cleanName(array.get(names, i)), text_color = color.white, text_size = f_size())
            table.cell(dash, 1, r, f_biasTxt(b), text_color = color.white, bgcolor = color.new(f_biasCol(b), 55), text_size = f_size())
            table.cell(dash, 2, r, f_trendTxt(tc), text_color = tc == 1 ? color.green : tc == -1 ? color.red : color.gray, text_size = f_size())
            table.cell(dash, 3, r, f_brkTxt(bc), text_color = bc == 1 ? color.green : bc == -1 ? color.red : color.gray, text_size = f_size())
            table.cell(dash, 4, r, f_pbTxt(ps), text_color = ps == 1 ? color.green : ps == -1 ? color.red : color.gray, text_size = f_size())
            table.cell(dash, 5, r, na(px) ? "n/a" : str.tostring(px, format.mintick), text_color = color.white, text_size = f_size())
