# Copy to .env and fill in. .env is gitignored.

# --- Webull OpenAPI credentials ---
WEBULL_APP_KEY=your_app_key
WEBULL_APP_SECRET=your_app_secret
WEBULL_REGION=us
# Paper/sandbox account id (retrieved via the smoke test / get_account_list)
WEBULL_ACCOUNT_ID=

# HTTP + events endpoints. Use the sandbox host for PAPER trading.
# Production:  api.webull.com          / events-api.webull.com
# Sandbox:     api.sandbox.webull.com  / events-api.sandbox.webull.com
WEBULL_API_ENDPOINT=api.sandbox.webull.com
WEBULL_EVENTS_ENDPOINT=events-api.sandbox.webull.com

# --- Webhook security ---
# Shared secret that must match the "secret" field in the TradingView alert JSON.
WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- Runtime ---
# DRY_RUN=true  -> no live orders; simulates fills so you can wire-test end to end.
# DRY_RUN=false -> sends real (paper/sandbox) orders via Webull OpenAPI.
DRY_RUN=true
HOST=127.0.0.1
PORT=8000
